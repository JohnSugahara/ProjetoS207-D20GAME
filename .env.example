# Copie para .env (NÃO versione o .env) e ajuste os valores.
POSTGRES_USER=d20
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=d20_arena

# Imagem do Jenkins no Docker Hub: <DOCKERHUB_USER>/d20-arena-jenkins:<JENKINS_IMAGE_TAG>
DOCKERHUB_USER=seu-usuario-dockerhub
JENKINS_IMAGE_TAG=1.0

JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=troque-esta-senha

# Repositório público que o Jenkins vai clonar
REPO_URL=https://github.com/ORGANIZACAO/d20-arena.git

# Quem recebe o e-mail do pipeline
NOTIFY_EMAIL=voce@exemplo.com
SMTP_FROM=jenkins@d20-arena.local
